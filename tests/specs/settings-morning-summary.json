[
  {
    "name": "Enable morning summary",
    "steps": [
      {
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Choose when to receive your daily summary. Times are UTC."
            }
          }
        ],
        "send": {
          "callback": "settings:morning_summary"
        }
      }
    ]
  }
]
