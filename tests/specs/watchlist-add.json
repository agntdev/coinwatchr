[
  {
    "name": "Add to watchlist",
    "steps": [
      {
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Choose a coin, or type its ticker."
            }
          }
        ],
        "send": {
          "callback": "watchlist:add"
        }
      }
    ]
  },
  {
    "name": "Add a pre-seeded coin",
    "steps": [
      { "send": { "callback": "watchlist:coin:BTC" }, "expect": [{ "method": "editMessageText", "payload": { "text": "Bitcoin is on your watchlist. Set an alert when you’re ready." } }] }
    ]
  }
]
